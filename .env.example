# Optional. Without it the planner returns clearly-labelled SAMPLE data and translation is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# PayPal Checkout Integration (PayPal AI Hackathon)
# Obtain credentials from PayPal Developer Portal: https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

# Serverless Persistence (Vercel KV / Upstash Redis) - Optional for production
# If unset, server-process storage with duplicate transaction protection is used
KV_REST_API_URL=
KV_REST_API_TOKEN=
